server:  
  port: 8081


spring:
  application:
    name: sa-gateway
  cloud:
    gateway:
      routes:
      # all website data comes from sa-mysql (sa-mongo and the /mongo/** route were removed)
      - id: sa-mysql
        uri: lb://sa-mysql/
        predicates:
        - Path=/ui/**
      globalcors:
        corsConfigurations:
          '[/**]':
            allowedOrigins: "*"
            allowedHeaders: "*"
            allowedMethods:
            - GET
            - POST
logging:
  level:
    org.springframework.web: ERROR

  
eureka:
  instance:
    statusPageUrl: http://0.0.0.0:${server.port}/info
    healthCheckUrl: http://0.0.0.0:${server.port}/health
    homePageUrl: http://0.0.0.0:${server.port}
  client:
    serviceUrl:
      defaultZone: http://0.0.0.0:8761/eureka/